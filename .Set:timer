local function clear(parent)
	for _, c in ipairs(parent:GetChildren()) do
		if not c:IsA("UIListLayout") then
			c:Destroy()
		end
	end
end

local function showView(name)
	listView.Visible = (name == "list")
	codeView.Visible = (name == "code")
	errorDetailView.Visible = (name == "error")
	backBtn.Visible = (name \~= "list")
	currentView = name
end

