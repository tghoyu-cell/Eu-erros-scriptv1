-- ServerScript (ServerScriptService)

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FixRemote = ReplicatedStorage:WaitForChild("FixScriptRemote")

-- COLOQUE SUA CHAVE DA OPENAI AQUI EMBAIXO
local OPENAI_API_KEY = "sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

local function findScriptByPath(path)
	local parts = string.split(path, ".")
	local current = game

	for i, part in ipairs(parts) do
		current = current:FindFirstChild(part)
		if not current then
			return nil
		end
	end

	if current:IsA("Script") or current:IsA("LocalScript") or current:IsA("ModuleScript") then
		return current
	end
	return nil
end

local function askChatGPT(source, errors)
	local errorText = ""
	for _, err in ipairs(errors) do
		errorText ..= "Linha " .. err.Line .. ": " .. err.Message .. "\n"
	end

	local prompt = [[
Você é um especialista em Luau (Roblox).
Corrija o seguinte script. Retorne APENAS o código corrigido, sem explicações, sem markdown, sem ```.

Erros reportados:
]] .. errorText .. [[

Código atual:
]] .. source

	local body = {
		model = "gpt-4o-mini",
		messages = {
			{ role = "system", content = "Você corrige códigos Luau do Roblox. Responda somente com o código corrigido." },
			{ role = "user", content = prompt }
		},
		temperature = 0.2
	}

	local success, response = pcall(function()
		return HttpService:RequestAsync({
			Url = "https://api.openai.com/v1/chat/completions",
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json",
				["Authorization"] = "Bearer " .. OPENAI_API_KEY
			},
			Body = HttpService:JSONEncode(body)
		})
	end)

	if not success then
		return nil, "Falha na requisição: " .. tostring(response)
	end

	if response.StatusCode \~= 200 then
		return nil, "Erro da API: " .. response.StatusCode .. " - " .. response.Body
	end

	local data = HttpService:JSONDecode(response.Body)
	local fixedCode = data.choices[1].message.content

	fixedCode = fixedCode:gsub("```lua", ""):gsub("```", ""):gsub("^%s+", ""):gsub("%s+$", "")

	return fixedCode, nil
end

FixRemote.OnServerEvent:Connect(function(player, path, source, errors)
	print("[FixScript] Pedido de", player.Name, "→", path)

	local fixedCode, err = askChatGPT(source, errors)

	if not fixedCode then
		FixRemote:FireClient(player, false, nil, err)
		return
	end

	local scriptObj = findScriptByPath(path)

	if scriptObj then
		local ok, setErr = pcall(function()
			scriptObj.Source = fixedCode
		end)

		if ok then
			print("[FixScript] Source atualizado com sucesso em", path)
			FixRemote:FireClient(player, true, fixedCode, "Corrigido e aplicado")
		else
			warn("[FixScript] Não foi possível alterar Source:", setErr)
			FixRemote:FireClient(player, true, fixedCode, "Código gerado (não foi possível aplicar Source)")
		end
	else
		FixRemote:FireClient(player, true, fixedCode, "Código gerado (script não encontrado no caminho)")
	end
end)

