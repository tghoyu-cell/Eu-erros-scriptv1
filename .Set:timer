local currentScript = nil
local currentView = "list" -- list | code | error

local function clearChildren(parent, keepLayout)
	for _, child in ipairs(parent:GetChildren()) do
		if not (keepLayout and child:IsA("UIListLayout")) then
			child:Destroy()
		end
	end
end

local function showView(viewName)
	listView.Visible = (viewName == "list")
	codeView.Visible = (viewName == "code")
	errorDetailView.Visible = (viewName == "error")
	backBtn.Visible = (viewName \~= "list")
	currentView = viewName
end

local function createScriptButton(scriptInfo)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -8, 0, 52)
	btn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
	btn.Text = ""
	btn.AutoButtonColor = false
	btn.Parent = listView

	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 8)
	btnCorner.Parent = btn

	-- Ícone do script
	local icon = Instance.new("ImageLabel")
	icon.Size = UDim2.new(0, 32, 0, 32)
	icon.Position = UDim2.new(0, 10, 0.5, -16)
	icon.BackgroundTransparency = 1
	icon.Image = "rbxassetid://6231961866"
	icon.Parent = btn

	-- Nome do script
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1, -100, 0, 22)
	nameLabel.Position = UDim2.new(0, 52, 0, 8)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = scriptInfo.Name
	nameLabel.TextColor3 = Color3.fromRGB(230, 230, 240)
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextSize = 14
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.Parent = btn

	-- Path
	local pathLabel = Instance.new("TextLabel")
	pathLabel.Size = UDim2.new(1, -100, 0, 18)
	pathLabel.Position = UDim2.new(0, 52, 0, 28)
	pathLabel.BackgroundTransparency = 1
	pathLabel.Text = scriptInfo.Path
	pathLabel.TextColor3 = Color3.fromRGB(140, 140, 160)
	pathLabel.Font = Enum.Font.Gotham
	pathLabel.TextSize = 11
	pathLabel.TextXAlignment = Enum.TextXAlignment.Left
	pathLabel.Parent = btn

	-- Ícone de erro (se tiver)
	if #scriptInfo.Errors > 0 then
		local errorIcon = Instance.new("ImageLabel")
		errorIcon.Size = UDim2.new(0, 24, 0, 24)
		errorIcon.Position = UDim2.new(1, -40, 0.5, -12)
		errorIcon.BackgroundTransparency = 1
		errorIcon.Image = "rbxassetid://17011999744"
		errorIcon.Parent = btn
	end

	btn.MouseButton1Click:Connect(function()
		currentScript = scriptInfo
		openScript(scriptInfo)
	end)

	return btn
end

function openScript(scriptInfo)
	showView("code")
	codeTitle.Text = scriptInfo.Name .. "  •  " .. scriptInfo.Path
	codeLabel.Text = scriptInfo.Source
	codeLabel.Size = UDim2.new(1, -16, 0, 20 + (#scriptInfo.Source:split("\n") * 16))
	codeScroll.CanvasSize = UDim2.new(0, 0, 0, codeLabel.Size.Y.Offset + 20)

	-- Mostra ou esconde o botão de corrigir
	fixBtn.Visible = true

	-- Limpa e cria os erros
	clearChildren(errorsScroll, true)

	if #scriptInfo.Errors == 0 then
		local noError = Instance.new("TextLabel")
		noError.Size = UDim2.new(1, 0, 0, 30)
		noError.BackgroundTransparency = 1
		noError.Text = "Nenhum erro encontrado ✓"
		noError.TextColor3 = Color3.fromRGB(120, 220, 140)
		noError.Font = Enum.Font.Gotham
		noError.TextSize = 14
		noError.Parent = errorsScroll
	else
		for i, err in ipairs(scriptInfo.Errors) do
			local errBtn = Instance.new("TextButton")
			errBtn.Size = UDim2.new(1, -4, 0, 40)
			errBtn.BackgroundColor3 = Color3.fromRGB(50, 30, 35)
			errBtn.Text = ""
			errBtn.Parent = errorsScroll

			local errCorner = Instance.new("UICorner")
			errCorner.CornerRadius = UDim.new(0, 6)
			errCorner.Parent = errBtn

			local errText = Instance.new("TextLabel")
			errText.Size = UDim2.new(1, -16, 1, 0)
			errText.Position = UDim2.new(0, 10, 0, 0)
			errText.BackgroundTransparency = 1
			errText.Text = "Linha " .. err.Line .. " → " .. err.Message
			errText.TextColor3 = Color3.fromRGB(255, 160, 160)
			errText.Font = Enum.Font.Gotham
			errText.TextSize = 13
			errText.TextXAlignment = Enum.TextXAlignment.Left
			errText.Parent = errBtn

			errBtn.MouseButton1Click:Connect(function()
				showErrorDetail(err)
			end)
		end
	end

	errorsScroll.CanvasSize = UDim2.new(0, 0, 0, errorsLayout.AbsoluteContentSize.Y + 10)
end

function showErrorDetail(err)
	showView("error")
	errorDetailTitle.Text = "Erro na linha " .. err.Line
	errorDetailBox.Text = "Mensagem:\n" .. err.Message .. "\n\nExplicação:\n" .. err.Explanation
end

local function refreshList()
	clearChildren(listView, true)
	for _, scriptInfo in ipairs(scriptsData) do
		createScriptButton(scriptInfo)
	end
	listView.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 10)
end

