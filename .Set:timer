-- ServerScript (ServerScriptService)

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FixRemote = ReplicatedStorage:WaitForChild("FixScriptRemote")

-- COLOQUE SUA CHAVE AQUI
local OPENAI_API_KEY = "sk-xxxxxxxxxxxxxxxxxxxxxxxx"

local function askChatGPT(source, errors)
	local errorText = ""
	for _, err in ipairs(errors or {}) do
		errorText = errorText .. "Linha " .. tostring(err.Line) .. ": " .. tostring(err.Message) .. "\n"
	end

	local prompt = "Corrija este script Luau do Roblox. Retorne SOMENTE o código corrigido, sem explicação e sem ```.\n\nErros:\n" .. errorText .. "\n\nCódigo:\n" .. source

	local body = {
		model = "gpt-4o-mini",
		messages = {
			{role = "system", content = "Você corrige códigos Luau. Responda só com o código."},
			{role = "user", content = prompt}
		},
		temperature = 0.2
	}

	local ok, response = pcall(function()
		return HttpService:RequestAsync({
			Url = "https://api.openai.com/v1/chat/completions",
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json",
				["Authorization"] = "Bearer " .. OPENAI_API_KEY
			},
			Body = HttpService:JSONEncode(body)
		})
	end)

	if not ok or response.StatusCode \~= 200 then
		return nil, "Erro na API"
	end

	local data = HttpService:JSONDecode(response.Body)
	local code = data.choices[1].message.content
	code = code:gsub("```lua", ""):gsub("```", ""):gsub("^%s+", ""):gsub("%s+$", "")
	return code
end

FixRemote.OnServerEvent:Connect(function(player, path, source, errors)
	local fixed = askChatGPT(source, errors)
	if fixed then
		FixRemote:FireClient(player, true, fixed, "ok")
	else
		FixRemote:FireClient(player, false, nil, "falhou")
	end
end)

