function openScript(info)
	showView("code")
	codeTitle.Text = info.Name
	codeLabel.Text = info.Source
	codeLabel.Size = UDim2.new(1, -15, 0, #string.split(info.Source, "\n") * 17 + 20)
	codeScroll.CanvasSize = UDim2.new(0, 0, 0, codeLabel.Size.Y.Offset + 20)

	fixBtn.Visible = true
	clear(errorsScroll)

	if #info.Errors == 0 then
		local t = Instance.new("TextLabel")
		t.Size = UDim2.new(1, 0, 0, 30)
		t.BackgroundTransparency = 1
		t.Text = "Nenhum erro encontrado ✓"
		t.TextColor3 = Color3.fromRGB(100, 220, 130)
		t.Font = Enum.Font.Gotham
		t.TextSize = 14
		t.Parent = errorsScroll
	else
		for _, err in ipairs(info.Errors) do
			local b = Instance.new("TextButton")
			b.Size = UDim2.new(1, -5, 0, 38)
			b.BackgroundColor3 = Color3.fromRGB(60, 35, 40)
			b.Text = ""
			b.Parent = errorsScroll

			local cc = Instance.new("UICorner")
			cc.CornerRadius = UDim.new(0, 6)
			cc.Parent = b

			local txt = Instance.new("TextLabel")
			txt.Size = UDim2.new(1, -15, 1, 0)
			txt.Position = UDim2.new(0, 10, 0, 0)
			txt.BackgroundTransparency = 1
			txt.Text = "Linha " .. err.Line .. " → " .. err.Message
			txt.TextColor3 = Color3.fromRGB(255, 160, 160)
			txt.Font = Enum.Font.Gotham
			txt.TextSize = 13
			txt.TextXAlignment = Enum.TextXAlignment.Left
			txt.Parent = b

			b.MouseButton1Click:Connect(function()
				showView("error")
				errorDetailTitle.Text = "Erro na linha " .. err.Line
				errorDetailBox.Text = "Mensagem:\n" .. err.Message .. "\n\nExplicação:\n" .. err.Explanation
			end)
		end
	end
end

local function refresh()
	clear(listView)
	for _, s in ipairs(scriptsData) do
		createScriptButton(s)
	end
	listView.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 10)
end

-- Eventos
toggleBtn.MouseButton1Click:Connect(function()
	mainFrame.Visible = not mainFrame.Visible
	if mainFrame.Visible then
		refresh()
		showView("list")
	end
end)

closeBtn.MouseButton1Click:Connect(function()
	mainFrame.Visible = false
end)

backBtn.MouseButton1Click:Connect(function()
	if currentView == "error" then
		showView("code")
	else
		showView("list")
	end
end)

fixBtn.MouseButton1Click:Connect(function()
	if not currentScript or isFixing then return end
	isFixing = true
	fixBtn.ImageTransparency = 0.5
	if FixRemote then
		FixRemote:FireServer(currentScript.Path, currentScript.Source, currentScript.Errors)
	end
end)

if FixRemote then
	FixRemote.OnClientEvent:Connect(function(success, newSource, msg)
		isFixing = false
		fixBtn.ImageTransparency = 0
		if success and newSource then
			currentScript.Source = newSource
			currentScript.Errors = {}
			openScript(currentScript)
		else
			warn("Erro:", msg)
		end
	end)
end

-- Inicia
refresh()
showView("list")
